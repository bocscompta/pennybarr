# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_COMPANY_ID=your-company-uuid

# Supabase (for scripts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
COMPANY_ID=your-company-uuid

# Pennylane (for sync scripts)
PENNYLANE_API_KEY=your-pennylane-api-key

# Dolibarr (for docker-compose)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=dolibarr
MYSQL_PASSWORD=changeme
DOLIBARR_ADMIN_LOGIN=admin
DOLIBARR_ADMIN_PASSWORD=changeme
